#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "pathname"
require "yaml"
require_relative "../lib/idiomatic_rails/dead_code"

options = { root: Dir.pwd, config: ".idiomatic-rails.yml" }

OptionParser.new do |parser|
  parser.banner = "Usage: idiomatic-rails-dead-code [options]"
  parser.on("--root PATH", "Application root (default: the working directory)") { |v| options[:root] = v }
  parser.on("--config PATH", "Config file (default: .idiomatic-rails.yml)") { |v| options[:config] = v }
  parser.on("-h", "--help") { puts parser; exit 0 }
end.parse!

config_path = Pathname.new(options[:root]).join(options[:config])
config = config_path.exist? ? (YAML.load_file(config_path) || {})["dead_code"] : nil

begin
  check = IdiomaticRails::DeadCode.new(root: options[:root], config: config)
  problems = check.problems
rescue IdiomaticRails::DeadCode::Error => e
  warn "idiomatic-rails-dead-code: #{e.message}"
  exit 1
end

if problems.empty?
  puts "  OK  #{check.definition_count} definitions, every one reached outside the tests"
  exit 0
end

problems.each { |problem| puts "  #{problem}" }
puts
puts "Delete it, or — if something outside this repository reaches it — record it under"
puts "`dead_code:` in #{options[:config]} with the reason. An exemption that stops being"
puts "needed fails too, so the file cannot quietly fill up with names nobody rechecks."
exit 1
